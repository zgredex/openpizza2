  "city_term": "100 - 3*(City+0x64 + City+0x4C) = 100 - 3*(VOLK[6]+VOLK[0]); Berlin 25",
  "category_effect": "trunc(city_term*(trunc(percent*(effect-40)/100)+40)/100), clamp 0..100",
