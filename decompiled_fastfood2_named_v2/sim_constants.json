  "media": "0 or 1..12; media 0 is the baseline; accept media only if gain >= 1",
  "flags": "greedy 1/2/4/8, accept only if gain >= 1",
  "category": "most-used ingredient index+1",
  "target": "best other company by average effect",
  "weights_table": "0x5730AC 12x8",
