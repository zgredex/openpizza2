{
  "name": "reload the saved London restaurant through 20:00",
  "env": {
    "PC2_TRACE_STAFF": "1",
    "PC2_TRACE_SALES": "1"
  },
  "watches": {
    "branch_id": {
      "address": "0x0057C670",
      "offsets": [
        "0x9C",
        "0x3C"
      ],
      "type": "u32"
    },
    "branch_player": {
      "address": "0x0057C670",
      "offsets": [
        "0x9C",
        "0x30"
      ],
      "type": "u32"
    },
    "staff_count": {
      "address": "0x0057C670",
      "offsets": [
        "0x9C",
        "0x1514"
      ],
      "type": "u32"
    },
    "cash": {
      "address": "0x0057C670",
      "offsets": [
        "0x200",
        "0x108"
      ],
      "type": "f64"
    },
    "minute": {
      "address": "0x0057C670",
      "offsets": [
        "0x94",
        6
      ],
      "type": "u8"
    },
    "hour": {
      "address": "0x0057C670",
      "offsets": [
        "0x94",
        7
      ],
      "type": "u8"
    }
  },
  "steps": [
    {
      "wait_function": "0x00476920"
    },
    {
      "delay_ms": 700
    },
    {
      "begin": "reload-save"
    },
    {
      "click": {
        "x": 650,
        "y": 106
      }
    },
    {
      "wait_function": "0x004750B0"
    },
    {
      "delay_ms": 700
    },
    {
      "click": {
        "x": 620,
        "y": 285
      }
    },
    {
      "delay_ms": 5000
    },
    {
      "snapshot": "after-load"
    },
    {
      "assert_value": {
        "watch": "branch_id",
        "equals": 100000
      }
    },
    {
      "assert_value": {
        "watch": "branch_player",
        "equals": 0
      }
    },
    {
      "assert_value": {
        "watch": "staff_count",
        "equals": 4
      }
    },
    {
      "assert_value": {
        "watch": "hour",
        "equals": 8
      }
    },
    {
      "end": "reload-save"
    },
    {
      "wait_value": {
        "watch": "hour",
        "equals": 9
      }
    },
    {
      "snapshot": "opening-hour"
    },
    {
      "wait_value": {
        "watch": "hour",
        "equals": 10
      }
    },
    {
      "snapshot": "after-opening"
    },
    {
      "wait_value": {
        "watch": "hour",
        "equals": 20
      }
    },
    {
      "snapshot": "checkpoint-20"
    },
    {
      "assert_value": {
        "watch": "branch_id",
        "equals": 100000
      }
    },
    {
      "assert_value": {
        "watch": "branch_player",
        "equals": 0
      }
    },
    {
      "assert_value": {
        "watch": "staff_count",
        "equals": 4
      }
    }
  ]
}