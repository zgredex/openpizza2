{
  "name": "save the loaded London checkpoint through the game writer",
  "env": {
    "PC2_SAVE_ON_LOAD": "1",
    "PC2_SAVE_SLOT": "1",
    "PC2_TRACE_STAFF": "1",
    "PC2_TRACE_SALES": "1"
  },
  "watches": {
    "branch_id": {"address": "0x0057C670", "offsets": ["0x9C", "0x3C"], "type": "u32"},
    "branch_player": {"address": "0x0057C670", "offsets": ["0x9C", "0x30"], "type": "u32"},
    "staff_count": {"address": "0x0057C670", "offsets": ["0x9C", "0x1514"], "type": "u32"},
    "minute": {"address": "0x0057C670", "offsets": ["0x94", 6], "type": "u8"},
    "hour": {"address": "0x0057C670", "offsets": ["0x94", 7], "type": "u8"}
  },
  "steps": [
    {"wait_function": "0x00476920"},
    {"delay_ms": 700},
    {"begin": "save-checkpoint"},
    {"click": {"x": 650, "y": 106}},
    {"wait_function": "0x004750B0"},
    {"delay_ms": 700},
    {"click": {"x": 620, "y": 285}},
    {"delay_ms": 5000},
    {"snapshot": "saved"},
    {"assert_value": {"watch": "branch_id", "equals": 100000}},
    {"assert_value": {"watch": "branch_player", "equals": 0}},
    {"assert_value": {"watch": "staff_count", "equals": 4}},
    {"end": "save-checkpoint"}
  ]
}
