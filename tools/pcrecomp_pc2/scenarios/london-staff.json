{
  "name": "lease and staff a London restaurant",
  "env": {
    "PC2_CLICK_START": "1",
    "PC2_START_CAMPAIGN": "1",
    "PC2_TUTORIAL_CLICKS": "2",
    "PC2_TUTORIAL_START": "1000",
    "PC2_TUTORIAL_INTERVAL": "400",
    "PC2_LEASE_CLICK": "1",
    "PC2_LEASE_DELAY": "1700",
    "PC2_CONFIRM_CLICK": "1",
    "PC2_CONFIRM_DELAY": "400",
    "PC2_TRACE_STAFF": "1"
  },
  "watches": {
    "branch_id": {"address": "0x0057C670", "offsets": ["0x9C", "0x3C"], "type": "u32"},
    "branch_player": {"address": "0x0057C670", "offsets": ["0x9C", "0x30"], "type": "u32"},
    "staff_count": {"address": "0x0057C670", "offsets": ["0x9C", "0x1514"], "type": "u32"},
    "minute": {"address": "0x0057C670", "offsets": ["0x94", 6], "type": "u8"},
    "hour": {"address": "0x0057C670", "offsets": ["0x94", 7], "type": "u8"}
  },
  "steps": [
    {"wait_value": {"watch": "branch_id", "equals": 100000}},
    {"assert_value": {"watch": "branch_player", "equals": 0}},
    {"assert_value": {"watch": "staff_count", "equals": 0}},
    {"delay_ms": 700},
    {"begin": "employment-office"},
    {"click": {"x": 534, "y": 153}},
    {"wait_function": "Game_CenterViewOnObject"},
    {"delay_ms": 400},
    {"click": {"x": 299, "y": 412}},
    {"wait_function": "UI_CreateInfoPanelPolice"},
    {"delay_ms": 350},
    {"click": {"x": 581, "y": 506}},
    {"wait_function": "Screen_PersonnelOverview"},
    {"delay_ms": 350},
    {"end": "employment-office"},
    {"begin": "hire-staff"},
    {"click": {"x": 746, "y": 328}},
    {"wait_value": {"watch": "staff_count", "equals": 1}},
    {"delay_ms": 350},
    {"click": {"x": 697, "y": 360}},
    {"delay_ms": 350},
    {"click": {"x": 746, "y": 328}},
    {"wait_value": {"watch": "staff_count", "equals": 2}},
    {"delay_ms": 350},
    {"click": {"x": 734, "y": 360}},
    {"delay_ms": 350},
    {"click": {"x": 746, "y": 328}},
    {"wait_value": {"watch": "staff_count", "equals": 3}},
    {"delay_ms": 350},
    {"click": {"x": 746, "y": 328}},
    {"wait_value": {"watch": "staff_count", "equals": 4}},
    {"assert_value": {"watch": "branch_id", "equals": 100000}},
    {"assert_value": {"watch": "branch_player", "equals": 0}},
    {"end": "hire-staff"}
  ]
}
